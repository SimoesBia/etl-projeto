# Copie para .env e ajuste. Caminhos relativos partem da raiz do projeto.
ETL_INPUT_PATH=data/raw/clientes.csv
ETL_OUTPUT_PATH=data/processed/mensagens_geradas.csv
ETL_REJECTED_PATH=data/processed/clientes_rejeitados.csv

# Opcional: grava também o resultado em um banco SQLite (deixe vazio para desativar)
ETL_SQLITE_PATH=

# Placeholders disponíveis: {nome} e {primeiro_nome}
ETL_MESSAGE_TEMPLATE=Olá {primeiro_nome}, temos novidades exclusivas para você!

# DEBUG | INFO | WARNING | ERROR
ETL_LOG_LEVEL=INFO
